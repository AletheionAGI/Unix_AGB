[Unit]
Description=Unix-AGB Gate 4 lifecycle guardian laboratory
Documentation=https://github.com/AletheionAGI/Unix_AGB
ConditionPathExists=/etc/unix-agb/egress-guardian.enabled
After=local-fs.target
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=simple
User=unix-agb-guardian
Group=unix-agb-guardian
ExecStart=/usr/bin/python3 /usr/libexec/unix-agb/agb-egress-guardian --config /etc/unix-agb/egress-guardian.json
RuntimeDirectory=unix-agb
RuntimeDirectoryMode=0750
StateDirectory=unix-agb
StateDirectoryMode=0750
Restart=on-failure
RestartSec=1s
KillMode=control-group
TimeoutStopSec=5s
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
UMask=0077
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
