[Unit]
Description=Unix-AGB administrative socket (laboratory)
After=local-fs.target

[Service]
Type=simple
WorkingDirectory=/opt/unix-agb
EnvironmentFile=-/etc/unix-agb/admin.env
# Prefer AGB_ADMIN_TOKEN_FILE=/etc/unix-agb/admin.token and configure UID/GID allowlists.
ExecStart=/opt/unix-agb/target/release/agb-admin-server /run/unix-agb/admin.sock /var/lib/unix-agb/policy-cache.jsonl /var/log/unix-agb/admin-audit.jsonl
Restart=on-failure
RestartSec=1s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/run/unix-agb /var/lib/unix-agb /var/log/unix-agb

[Install]
WantedBy=multi-user.target
