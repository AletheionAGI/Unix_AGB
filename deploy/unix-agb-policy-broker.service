[Unit]
Description=Unix-AGB policy broker (laboratory)
After=local-fs.target

[Service]
Type=simple
WorkingDirectory=/opt/unix-agb
ExecStart=/opt/unix-agb/target/release/agb-policy-broker /run/unix-agb/policy.sock /var/lib/unix-agb/enforcement.jsonl
Restart=on-failure
RestartSec=1s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/run/unix-agb /var/lib/unix-agb

[Install]
WantedBy=multi-user.target
