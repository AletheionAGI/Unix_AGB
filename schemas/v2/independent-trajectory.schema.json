{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unixagb.com/schemas/v2/independent-trajectory.schema.json",
  "title": "IndependentTrajectoryV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["trajectory_id", "label", "label_source", "family", "split", "collector_revision", "coverage_scope", "coverage_config_sha256", "subject_scope", "evaluation_purpose", "events"],
  "properties": {
    "trajectory_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "label": { "enum": ["benign", "malicious"] },
    "label_source": { "type": "string", "minLength": 1, "maxLength": 256 },
    "family": { "type": "string", "minLength": 1, "maxLength": 128 },
    "split": { "enum": ["calibration", "test"] },
    "collector_revision": { "type": "string", "minLength": 1, "maxLength": 128 },
    "coverage_scope": { "enum": ["system-wide", "protected-only", "allowlist"] },
    "coverage_config_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "subject_scope": { "enum": ["protected", "external"] },
    "evaluation_purpose": { "enum": ["security-efficacy", "false-positive-monitoring"] },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "../v1/security-event.schema.json" }
    }
  }
}
