{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unixagb.com/schemas/v1/security-event.schema.json",
  "title": "SecurityEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "sequence", "occurred_at", "monotonic_ns", "host_id", "namespace_id", "subject", "operation", "resource", "result", "policy_revision", "labels", "provenance"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "event_id": { "type": "string", "pattern": "^evt:[A-Za-z0-9._-]+(?::[A-Za-z0-9._-]+)*$", "maxLength": 128 },
    "sequence": { "type": "integer", "minimum": 1 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "monotonic_ns": { "type": "integer", "minimum": 0 },
    "host_id": { "type": "string", "pattern": "^host:[A-Za-z0-9._-]+$", "maxLength": 160 },
    "namespace_id": { "type": "string", "pattern": "^(process|user|service|container|cgroup|agent|tenant|session|host):.+$", "maxLength": 512 },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pid", "uid", "gid", "boot_id", "start_time_ns", "exe"],
      "properties": {
        "pid": { "type": "integer", "minimum": 1 },
        "ppid": { "type": "integer", "minimum": 0 },
        "uid": { "type": "integer", "minimum": 0 },
        "gid": { "type": "integer", "minimum": 0 },
        "boot_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "start_time_ns": { "type": "integer", "minimum": 1 },
        "exe": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "cmdline": { "type": "array", "maxItems": 256, "items": { "type": "string", "maxLength": 4096 } },
        "service": { "type": ["string", "null"], "maxLength": 256 },
        "container_id": { "type": ["string", "null"], "maxLength": 256 },
        "agent_id": { "type": ["string", "null"], "maxLength": 256 }
      }
    },
    "operation": { "enum": ["process.exec", "process.exit", "file.open", "network.connect", "identity.change"] },
    "resource": { "type": "object", "additionalProperties": true, "required": ["type"], "properties": { "type": { "type": "string", "minLength": 1, "maxLength": 64 } } },
    "result": { "enum": ["requested", "allowed", "denied", "failed"] },
    "policy_revision": { "type": "string", "minLength": 1, "maxLength": 128 },
    "labels": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "maxLength": 64 } },
    "provenance": { "type": "object", "additionalProperties": true, "required": ["source"], "properties": { "source": { "enum": ["synthetic", "ptrace", "bpf", "audit", "agent-broker"] } } }
  }
}
