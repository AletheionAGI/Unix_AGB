// Gate 1 laboratory observer. It emits newline-delimited records that can be
// normalized by the Event Gateway. It observes; it never blocks a syscall.
// Requires: bpftrace, tracefs, and the privileges required by the host.

tracepoint:syscalls:sys_enter_execve
    /($1 == 4294967295 || uid == $1) && pid != $2/
{
  printf("AGB_BPF|process.exec|pid=%d|uid=%d|gid=%d|comm=%s|exe=%s\n", pid, uid, gid, comm, str(args->filename));
}

tracepoint:syscalls:sys_enter_openat
    /($1 == 4294967295 || uid == $1) && pid != $2/
{
  printf("AGB_BPF|file.open|pid=%d|uid=%d|gid=%d|comm=%s|path=%s\n", pid, uid, gid, comm, str(args->filename));
}

tracepoint:syscalls:sys_enter_connect
    /($1 == 4294967295 || uid == $1) && pid != $2/
{
  $sa = (struct sockaddr *)uptr(args->uservaddr);
  $family = $sa->sa_family;
  $fd = (int64)args->fd;
  $type = @socket_type[pid, $fd];
  $protocol = @socket_protocol[pid, $fd];
  if ($family == 2) {
    $sin = (struct sockaddr_in *)$sa;
    printf("AGB_BPF|network.connect|pid=%d|uid=%d|gid=%d|comm=%s|fd=%d|family=AF_INET|address=%s|port=%d|socket_type=%d|protocol=%d|addrlen=%d\n",
      pid, uid, gid, comm, $fd, ntop(2, $sin->sin_addr.s_addr), bswap($sin->sin_port), $type, $protocol, args->addrlen);
  } else if ($family == 10) {
    $sin6 = (struct sockaddr_in6 *)$sa;
    printf("AGB_BPF|network.connect|pid=%d|uid=%d|gid=%d|comm=%s|fd=%d|family=AF_INET6|address=%s|port=%d|socket_type=%d|protocol=%d|addrlen=%d\n",
      pid, uid, gid, comm, $fd, ntop(10, $sin6->sin6_addr.in6_u.u6_addr8), bswap($sin6->sin6_port), $type, $protocol, args->addrlen);
  } else if ($family == 1) {
    $sun = (struct sockaddr_un *)$sa;
    printf("AGB_BPF|network.connect|pid=%d|uid=%d|gid=%d|comm=%s|fd=%d|family=AF_UNIX|unix_path=%s|socket_type=%d|protocol=%d|addrlen=%d\n",
      pid, uid, gid, comm, $fd, str($sun->sun_path), $type, $protocol, args->addrlen);
  } else {
    printf("AGB_BPF|network.connect|pid=%d|uid=%d|gid=%d|comm=%s|fd=%d|family=%d|socket_type=%d|protocol=%d|addrlen=%d\n",
      pid, uid, gid, comm, $fd, $family, $type, $protocol, args->addrlen);
  }
}

tracepoint:syscalls:sys_enter_socket
    /($1 == 4294967295 || uid == $1) && pid != $2/
{
  @pending_socket_family[tid] = args->family;
  @pending_socket_type[tid] = args->type;
  @pending_socket_protocol[tid] = args->protocol;
}

tracepoint:syscalls:sys_exit_socket
    /@pending_socket_family[tid]/
{
  if (args->ret >= 0) {
    $fd = (int64)args->ret;
    @socket_family[pid, $fd] = @pending_socket_family[tid];
    @socket_type[pid, $fd] = @pending_socket_type[tid];
    @socket_protocol[pid, $fd] = @pending_socket_protocol[tid];
  }
  delete(@pending_socket_family[tid]);
  delete(@pending_socket_type[tid]);
  delete(@pending_socket_protocol[tid]);
}

tracepoint:syscalls:sys_enter_close
{
  $fd = (int64)args->fd;
  delete(@socket_family[pid, $fd]);
  delete(@socket_type[pid, $fd]);
  delete(@socket_protocol[pid, $fd]);
}
